# Backend (Flask). Real values go in Render's Environment settings, not in git.

# Neon Postgres. Neon shows a postgres:// URL -- rewrite the scheme to
# postgresql+psycopg:// so SQLAlchemy uses psycopg3, which is what
# requirements.txt pins. Keep the ?sslmode=require that Neon appends.
DATABASE_URI=postgresql+psycopg://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Comma-separated allowed origins. Must include the deployed frontend.
CORS_ORIGINS=https://your-app.vercel.app

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

FLASK_ENV=production

# Memory guards for a 512MB instance. See Dockerfile for why.
TORCH_NUM_THREADS=1
MAX_FRAME_DIMENSION=640
