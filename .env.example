# Frontend (Vite). These are compiled into the bundle at BUILD time and are
# visible to anyone who loads the page -- never put a secret here.
# Set the same values in the Vercel project's Environment Variables.

# Base origin of the backend, with no trailing slash and no /api suffix
# (api.ts appends /api itself). Leave blank to use same-origin /api.
VITE_API_BASE_URL=https://deepdetect-api.onrender.com

# Google OAuth *client ID*. Public by design; the client secret is not used here.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
